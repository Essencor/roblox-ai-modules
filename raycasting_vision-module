-- UNIFIED MAP  (must be defined before dome & noclip so both can write to it)
-- ===================================

-- Source colours used by all three ray types
local UNIFIED_SOURCE_COLOR = {
    noclip     = Color3.new(0.7, 0, 1),    -- purple
    dome       = Color3.new(0, 1, 1),      -- cyan
    reflection = Color3.new(1, 0.85, 0),   -- yellow
}
local UNIFIED_MAX = 6000

local function StoreUnifiedCell(position, source, normal, instance)
    local cs  = math.max(1, Config.NoclipCellSize)
    local key = source .. "_"
        .. math.floor(position.X / cs) .. ","
        .. math.floor(position.Y / cs) .. ","
        .. math.floor(position.Z / cs)
    local now   = tick()
    local entry = State.unifiedMap[key]
    if not entry then
        entry = {
            key       = key,
            position  = position,
            normal    = normal,
            instance  = instance,
            source    = source,
            color     = UNIFIED_SOURCE_COLOR[source] or Color3.new(1, 1, 1),
            firstSeen = now,
            lastSeen  = now,
        }
        State.unifiedMap[key] = entry
        table.insert(State.unifiedMapOrder, key)
    else
        entry.position = position
        entry.normal   = normal
        entry.instance = instance
        entry.lastSeen = now
    end
    -- Evict oldest when over cap
    while #State.unifiedMapOrder > UNIFIED_MAX do
        local old = table.remove(State.unifiedMapOrder, 1)
        State.unifiedMap[old] = nil
    end
end

-- ===================================
-- BACKGROUND DOME + REFLECTION MAPPING
-- ===================================

local function ClampNumber(value, minValue, maxValue)
    if value < minValue then return minValue end
    if value > maxValue then return maxValue end
    return value
end

local function GetMapCellKey(position)
    local cellSize = math.max(1, Config.DomeMapCellSize)
    return tostring(math.floor(position.X / cellSize)) .. "," ..
           tostring(math.floor(position.Y / cellSize)) .. "," ..
           tostring(math.floor(position.Z / cellSize))
end

local function PruneDomeMap()
    local now = tick()
    local newOrder = {}
    local count = 0

    for _, key in ipairs(State.domeMapOrder) do
        local entry = State.domeMap[key]
        if entry and (now - entry.lastSeen) <= Config.DomeMapEntryTTL then
            table.insert(newOrder, key)
            count = count + 1
        else
            State.domeMap[key] = nil
        end
    end

    State.domeMapOrder = newOrder

    while count > Config.DomeMapMaxEntries and #State.domeMapOrder > 0 do
        local oldestKey = table.remove(State.domeMapOrder, 1)
        if State.domeMap[oldestKey] then
            State.domeMap[oldestKey] = nil
            count = count - 1
        end
    end
end

local function StoreDomeHit(origin, direction, result, kind, bounceIndex, sourceKey)
    if not result then return nil end
    if IsTerrainGroundHit(result) then
        Stats.terrainGroundSkipped = Stats.terrainGroundSkipped + 1
        return nil
    end

    local key = GetMapCellKey(result.Position)
    local now = tick()
    local entry = State.domeMap[key]

    if not entry then
        entry = {
            key = key,
            position = result.Position,
            normal = result.Normal,
            instance = result.Instance,
            material = result.Material,
            distance = (result.Position - origin).Magnitude,
            firstSeen = now,
            lastSeen = now,
            hits = 0,
            kind = kind,
            bounce = bounceIndex or 0,
            sourceKey = sourceKey
        }
        State.domeMap[key] = entry
        table.insert(State.domeMapOrder, key)
    else
        entry.position = result.Position
        entry.normal = result.Normal
        entry.instance = result.Instance
        entry.material = result.Material
        entry.distance = (result.Position - origin).Magnitude
        entry.lastSeen = now
        entry.kind = kind
        entry.bounce = bounceIndex or entry.bounce or 0
        entry.sourceKey = sourceKey or entry.sourceKey
    end

    entry.hits = entry.hits + 1

    -- Write to unified map — skip floor/ceiling (mostly vertical normals)
    if math.abs(result.Normal.Y) <= 0.7 then
        local unifiedSource = (kind == "reflection") and "reflection" or "dome"
        StoreUnifiedCell(result.Position, unifiedSource, result.Normal, result.Instance)
    end

    if sourceKey then
        table.insert(State.reflectionEdges, {
            from = sourceKey,
            to = key,
            bounce = bounceIndex or 1,
            time = now
        })

        if #State.reflectionEdges > Config.DomeMapMaxEntries then
            table.remove(State.reflectionEdges, 1)
        end
    end

    return key, entry
end

local function GetDomeDirection(rayIndex)
    local horizontalSteps = math.max(4, Config.DomeHorizontalSteps)
    local verticalSteps = math.max(2, Config.DomeVerticalSteps)
    local totalSteps = horizontalSteps * verticalSteps
    local index = rayIndex % totalSteps
    local yawIndex = index % horizontalSteps
    local pitchIndex = math.floor(index / horizontalSteps)

    local yaw = (math.pi * 2 / horizontalSteps) * yawIndex
    local pitchAlpha = verticalSteps == 1 and 0.5 or (pitchIndex / (verticalSteps - 1))
    local pitchMin = math.rad(Config.DomePitchMin)
    local pitchMax = math.rad(Config.DomePitchMax)
    local pitch = pitchMin + ((pitchMax - pitchMin) * pitchAlpha)
    local horizontal = math.cos(pitch)

    return Vector3.new(math.cos(yaw) * horizontal, math.sin(pitch), math.sin(yaw) * horizontal).Unit
end

local function ReflectDirection(direction, normal)
    -- Back-face hit: ray came through the inside of a surface so the normal
    -- points the same way as the ray.  Reflecting in this case produces a
    -- bogus direction, so skip it entirely.
    if direction:Dot(normal) >= 0 then
        return nil
    end
    local reflected = direction - (2 * direction:Dot(normal) * normal)
    if reflected.Magnitude < 0.001 then
        return nil
    end
    return reflected.Unit
end

local function TraceDomeRay(origin, direction, shouldReflect)
    local castsUsed = 1
    local result = PerformRaycast(origin, direction, Config.DomeScanRadius, false)

    -- Visualize FIRST so a storage error can never block the ray display
    VisualizeRay(origin, direction, Config.DomeScanRadius, result, Config.RayColor)

    if result then
        Stats.domeHits = Stats.domeHits + 1
    end

    local _ok, sourceKey = pcall(StoreDomeHit, origin, direction, result, "primary", 0, nil)

    if not result or not shouldReflect or not Config.ReflectionMappingEnabled then
        return castsUsed
    end

    if IsTerrainGroundHit(result) then
        return castsUsed
    end

    -- Only reflect off walls (vertical normals) not floors/ceilings.
    -- Floor/ceiling hits have a high Y component on their normal; reflecting
    -- off them just sends the ray bouncing vertically and it never travels
    -- far horizontally down corridors.
    if math.abs(result.Normal.Y) > 0.7 then
        return castsUsed
    end

    local bounceOrigin = result.Position + (result.Normal * Config.ReflectionSurfaceOffset)
    local bounceDirection = ReflectDirection(direction, result.Normal)

    for bounce = 1, Config.ReflectionBounceCount do
        if not bounceDirection then
            break
        end

        castsUsed = castsUsed + 1
        Stats.reflectionRays = Stats.reflectionRays + 1

        local bounceResult = PerformRaycast(bounceOrigin, bounceDirection, Config.ReflectionDistance, false)
        -- Visualize before storage so errors in StoreDomeHit can't block display
        VisualizeRay(bounceOrigin, bounceDirection, Config.ReflectionDistance, bounceResult, Config.ReflectionColor)

        if bounceResult then Stats.reflectionHits = Stats.reflectionHits + 1 end
        local _ok2, nextKey = pcall(StoreDomeHit, bounceOrigin, bounceDirection, bounceResult, "reflection", bounce, sourceKey)

        if not bounceResult then
            -- Ray traveled full ReflectionDistance without hitting anything
            -- (open corridor end) — nothing more to bounce off, stop here.
            break
        end

        if IsTerrainGroundHit(bounceResult) then
            break
        end

        -- Skip reflecting off floors/ceilings mid-bounce too
        if math.abs(bounceResult.Normal.Y) > 0.7 then
            break
        end

        sourceKey = nextKey or sourceKey
        bounceOrigin = bounceResult.Position + (bounceResult.Normal * Config.ReflectionSurfaceOffset)
        bounceDirection = ReflectDirection(bounceDirection, bounceResult.Normal)
    end

    return castsUsed
end

local function ApplyDomeOptions(options)
    if not options then return end

    local optionMap = {
        radius = "DomeScanRadius",
        horizontalSteps = "DomeHorizontalSteps",
        verticalSteps = "DomeVerticalSteps",
        pitchMin = "DomePitchMin",
        pitchMax = "DomePitchMax",
        raysPerStep = "DomeRaysPerStep",
        stepWait = "DomeStepWait",
        reflectionBounces = "ReflectionBounceCount",
        reflectionDistance = "ReflectionDistance",
        reflectionEvery = "ReflectionEveryNRays",
        enabled = "DomeMappingEnabled"
    }

    for key, value in pairs(options) do
        local configKey = optionMap[key] or key
        if Config[configKey] ~= nil then
            Config[configKey] = value
        end
    end
end

function RaycastingVision.StepDomeMapping(rayBudget)
    if not Config.DomeMappingEnabled then
        return nil
    end

    local rootPart = GetRootPart()
    if not rootPart then
        return nil
    end

    rayBudget = rayBudget or Config.DomeRaysPerStep
    rayBudget = ClampNumber(math.floor(rayBudget), 1, Config.MaxRaysPerFrame)

    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local horizontalSteps = math.max(4, Config.DomeHorizontalSteps)
    local verticalSteps = math.max(2, Config.DomeVerticalSteps)
    local totalSteps = horizontalSteps * verticalSteps
    local castsUsed = 0
    local primaryRays = 0
    local startedAt = State.domeRayIndex
    local _, _, stepTimeBudget = GetDomeStepSettings()
    local deadline = os.clock() + math.max(0.001, stepTimeBudget or Config.DomeStepTimeBudget or 0.006)

    while castsUsed < rayBudget and os.clock() < deadline do
        local direction = GetDomeDirection(State.domeRayIndex)
        local shouldReflect = Config.ReflectionEveryNRays <= 1 or (State.domeRayIndex % Config.ReflectionEveryNRays == 0)
        castsUsed = castsUsed + TraceDomeRay(origin, direction, shouldReflect)
        primaryRays = primaryRays + 1
        State.domeRayIndex = (State.domeRayIndex + 1) % totalSteps

        if State.domeRayIndex == 0 and startedAt ~= 0 then
            Stats.domeSweeps = Stats.domeSweeps + 1
            State.lastDomeSweep = tick()
            break
        end
    end

    PruneDomeMap()

    State.lastDomeSummary = {
        primaryRays = primaryRays,
        raycasts = castsUsed,
        mappedCells = #State.domeMapOrder,
        reflectionEdges = #State.reflectionEdges,
        nextIndex = State.domeRayIndex,
        time = tick()
    }

    return State.lastDomeSummary
end

function RaycastingVision.StartDomeMapping(options)
    ApplyDomeOptions(options)

    if State.mappingActive then
        return true
    end

    State.mappingActive = true
    State.mappingGeneration = State.mappingGeneration + 1
    local generation = State.mappingGeneration

    task.spawn(function()
        while State.mappingActive and State.mappingGeneration == generation do
            local raysPerStep, stepWait = GetDomeStepSettings()
            local ok, err = pcall(function()
                RaycastingVision.StepDomeMapping(raysPerStep)
            end)

            if not ok then
                Log("Dome mapping step failed: " .. tostring(err), "WARN")
            end

            -- Also drive the 3D visualizer from the dome loop so it works
            -- even when noclip mapping hasn't started yet
            pcall(Update3DVisualization)

            task.wait(stepWait)
        end
    end)

    Log("Background dome mapping started")
    return true
end

function RaycastingVision.StopDomeMapping()
    State.mappingActive = false
    State.mappingGeneration = State.mappingGeneration + 1
    Log("Background dome mapping stopped")
end

function RaycastingVision.IsDomeMappingActive()
    return State.mappingActive
end

function RaycastingVision.ClearDomeMap()
    State.domeMap = {}
    State.domeMapOrder = {}
    State.reflectionEdges = {}
    State.lastDomeSummary = nil
    Log("Dome map cleared")
end

function RaycastingVision.GetDomeMap()
    return State.domeMap
end

function RaycastingVision.GetReflectionEdges()
    return State.reflectionEdges
end

function RaycastingVision.GetDomeSummary()
    return State.lastDomeSummary or {
        primaryRays = 0,
        raycasts = 0,
        mappedCells = #State.domeMapOrder,
        reflectionEdges = #State.reflectionEdges,
        nextIndex = State.domeRayIndex,
        time = tick()
    }
end

-- ===================================
-- NOCLIP SPHERE MAPPING (WALL-PENETRATING)
-- ===================================

-- Build a sphere of directions sweeping top-to-bottom in horizontal rings.
-- Each latitude band completes a full 360° sweep before descending to the next.
-- vertSteps rings from pole to pole; each ring has horzSteps evenly spaced rays.
local function ComputeFibonacciSphere(count)
    local directions = {}
    local vertSteps = math.max(2, math.round(math.sqrt(count / 2)))
    local horzSteps = math.max(1, math.round(count / vertSteps))
    for v = 0, vertSteps - 1 do
        local theta = math.pi * (v + 0.5) / vertSteps   -- top (0) → bottom (π)
        local sinT  = math.sin(theta)
        local cosT  = math.cos(theta)
        for h = 0, horzSteps - 1 do
            local phi = 2 * math.pi * h / horzSteps
            table.insert(directions, Vector3.new(
                sinT * math.cos(phi),
                cosT,
                sinT * math.sin(phi)
            ))
        end
    end
    return directions
end

local function GetNoclipCellKey(position)
    local cs = math.max(1, Config.NoclipCellSize)
    return math.floor(position.X / cs) .. ","
        .. math.floor(position.Y / cs) .. ","
        .. math.floor(position.Z / cs)
end

local function StoreNoclipCell(position, normal, instance, material)
    local key = GetNoclipCellKey(position)
    local now = tick()
    local entry = State.noclipMap[key]
    if not entry then
        entry = {
            key       = key,
            position  = position,
            normal    = normal,
            instance  = instance,
            material  = material,
            firstSeen = now,
            lastSeen  = now,
            hits      = 0
        }
        State.noclipMap[key] = entry
        table.insert(State.noclipMapOrder, key)
    else
        entry.position = position
        entry.normal   = normal
        entry.instance = instance
        entry.material = material
        entry.lastSeen = now
    end
    entry.hits = entry.hits + 1
    StoreUnifiedCell(position, "noclip", normal, instance)
end

-- Mark a grid cell as confirmed free/open (ray passed through it).
-- This gives Dijkstra a "known corridor" map to prefer when routing.
local FREE_MAP_MAX = 20000
local function StoreFreeCell(position)
    local cs  = math.max(1, Config.NoclipCellSize)
    local key = math.floor(position.X / cs) .. ","
             .. math.floor(position.Y / cs) .. ","
             .. math.floor(position.Z / cs)
    -- Don't overwrite a wall cell with a free cell
    if State.noclipMap[key] then return end
    if State.freeMap[key] then return end

    State.freeMap[key] = position
    table.insert(State.freeMapOrder, key)
    -- Simple cap — just overwrite oldest key by resetting when full
    while #State.freeMapOrder > FREE_MAP_MAX do
        local oldKey = table.remove(State.freeMapOrder, 1)
        if oldKey then
            State.freeMap[oldKey] = nil
        end
    end
end

local function PruneNoclipMap()
    local now = tick()
    local newOrder = {}
    for _, key in ipairs(State.noclipMapOrder) do
        local entry = State.noclipMap[key]
        if entry and (now - entry.lastSeen) <= Config.NoclipCellTTL then
            table.insert(newOrder, key)
        else
            State.noclipMap[key] = nil
        end
    end
    State.noclipMapOrder = newOrder
    while #State.noclipMapOrder > Config.NoclipMaxCells do
        local old = table.remove(State.noclipMapOrder, 1)
        State.noclipMap[old] = nil
    end
end

-- Cast one noclip ray: passes through every wall, recording each solid hit.
-- Uses an ever-growing exclude list so workspace:Raycast punches through
-- already-hit parts on repeated casts along the same direction.
local function CastNoclipRay(origin, direction, deadline)
    local currentOrigin = origin
    local totalTraveled = 0
    local excludeList   = {}
    local character     = GetCharacter()
    if character then
        table.insert(excludeList, character)
    end

    for _ = 1, Config.NoclipMaxHitsPerRay do
        if deadline and os.clock() >= deadline then break end
        if totalTraveled >= Config.NoclipMaxDistance then break end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = excludeList

        local remaining = Config.NoclipMaxDistance - totalTraveled
        local result = workspace:Raycast(currentOrigin, direction * remaining, params)
        if not result then break end
        NoteTerrainHit(result)

        local segDist = (result.Position - currentOrigin).Magnitude
        totalTraveled = totalTraveled + segDist

        -- Sample confirmed-free cells along the ray segment before the wall.
        -- Step every NoclipCellSize studs so we get one sample per grid cell.
        local cellStep = math.max(Config.NoclipFreeCellStep or Config.NoclipCellSize, Config.NoclipCellSize)
        local steps    = math.floor(segDist / cellStep)
        for s = 1, steps - 1 do   -- exclude the endpoint (that's the wall)
            local samplePos = currentOrigin + direction * (s * cellStep)
            StoreFreeCell(samplePos)
        end

        local terrainGroundHit = IsTerrainGroundHit(result)
        if terrainGroundHit then
            Stats.terrainGroundSkipped = Stats.terrainGroundSkipped + 1
        else
            StoreNoclipCell(result.Position, result.Normal, result.Instance, result.Material)
            Stats.noclipHits = Stats.noclipHits + 1
        end

        -- Purple noclip ray visualisation — use shared pool, throttled
        if Config.ShowRays then
            rayVisCounter = rayVisCounter + 1
            if rayVisCounter % Config.RayVisualizeEveryN == 0 then
                local rayLen = (result.Position - currentOrigin).Magnitude
                if rayLen > 0.1 then
                    local part = GetPooledRayPart()
                    part.Size         = Vector3.new(0.05, 0.05, rayLen)
                    part.CFrame       = CFrame.new((currentOrigin + result.Position) * 0.5, result.Position)
                    part.Color        = Config.NoclipColor
                    part.Transparency = 0.55
                    task.delay(Config.RayVisualLifetime, function()
                        if part and part.Parent then part.Transparency = 1 end
                    end)
                end
            end
        end

        if IsTerrainInstance(result.Instance) then
            break
        end

        -- Add hit part to exclude list so next cast passes through it
        if result.Instance then
            table.insert(excludeList, result.Instance)
        end
        currentOrigin = result.Position + direction * 0.05
    end

    Stats.noclipRays = Stats.noclipRays + 1
end

function RaycastingVision.StepNoclipScan(rayBudget)
    if not Config.NoclipEnabled then return nil end
    local rootPart = GetRootPart()
    if not rootPart then return nil end

    -- Lazily pre-compute the Fibonacci sphere directions once
    if not State.noclipDirections then
        State.noclipDirections = ComputeFibonacciSphere(Config.NoclipSphereRays)
    end

    rayBudget = rayBudget or Config.NoclipRaysPerStep
    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local total  = #State.noclipDirections
    local processed = 0
    local _, _, stepTimeBudget = GetNoclipStepSettings()
    local deadline = os.clock() + math.max(0.001, stepTimeBudget or Config.NoclipStepTimeBudget or 0.005)

    while processed < rayBudget and os.clock() < deadline do
        local dir = State.noclipDirections[(State.noclipRayIndex % total) + 1]
        CastNoclipRay(origin, dir, deadline)
        processed = processed + 1
        State.noclipRayIndex = (State.noclipRayIndex + 1) % total

        if State.noclipRayIndex == 0 then
            -- Completed one full sphere sweep
            Stats.noclipScans = Stats.noclipScans + 1
            State.noclipLastFullScan = tick()
            PruneNoclipMap()
            break
        end
    end

    return {
        raysProcessed = processed,
        mapCells      = #State.noclipMapOrder,
        scanIndex     = State.noclipRayIndex,
        totalRays     = total
    }
end

