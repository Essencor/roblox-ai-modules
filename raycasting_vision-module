function RaycastingVision.StartNoclipMapping()
    if not Config.NoclipEnabled then return false end
    if State.noclipActive then return true end

    if not State.noclipDirections then
        State.noclipDirections = ComputeFibonacciSphere(Config.NoclipSphereRays)
    end

    State.noclipActive    = true
    State.noclipGeneration = State.noclipGeneration + 1
    local generation = State.noclipGeneration

    task.spawn(function()
        while State.noclipActive and State.noclipGeneration == generation do
            local ok, err = pcall(function()
                RaycastingVision.StepNoclipScan(Config.NoclipRaysPerStep)
            end)
            if not ok then
                Log("Noclip scan step failed: " .. tostring(err), "WARN")
            end
            -- Refresh 2D minimap and 3D visualizer (both throttled internally)
            pcall(UpdateNoclipMapDisplay)
            pcall(Update3DVisualization)
            task.wait(Config.NoclipStepWait)
        end
    end)

    Log("Noclip sphere mapping started ("
        .. Config.NoclipSphereRays .. " rays/sweep, Fibonacci distribution)", "INFO")
    return true
end

