-- ===================================
-- UTILITY FUNCTIONS
-- ===================================

local function Log(message, level)
    level = level or "INFO"
    print("[RaycastVision:" .. level .. "] " .. tostring(message))
end

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRootPart()
    local character = GetCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function CreateCacheKey(origin, direction, distance)
    return tostring(math.floor(origin.X)) .. "," .. tostring(math.floor(origin.Y)) .. "," .. tostring(math.floor(origin.Z)) .. "_" ..
           tostring(math.floor(direction.X * 100)) .. "," .. tostring(math.floor(direction.Y * 100)) .. "," .. tostring(math.floor(direction.Z * 100)) .. "_" ..
           tostring(math.floor(distance))
end

-- ===================================
-- VISUALIZATION
-- ===================================

local function ClearVisualizations()
    for _, visual in ipairs(State.visualizations) do
        if visual and visual.Parent then
            visual:Destroy()
        end
    end
    State.visualizations = {}
end

local function VisualizeRay(origin, direction, distance, hit, color)
    if not Config.ShowRays then return end
    
    local endPos = origin + (direction * distance)
    if hit then
        endPos = hit.Position
    end
    
    local rayLength = (endPos - origin).Magnitude
    local midpoint = (origin + endPos) / 2
    
    local part = Instance.new("Part")
    part.Size = Vector3.new(0.1, 0.1, rayLength)
    part.CFrame = CFrame.new(midpoint, endPos)
    part.Anchored = true
    part.CanCollide = false
    part.Color = color or Config.RayColor
    part.Material = Enum.Material.Neon
    part.Transparency = 0.7
    part.Parent = workspace
    
    table.insert(State.visualizations, part)
    
    task.delay(0.5, function()
        if part and part.Parent then
            part:Destroy()
        end
    end)
end

local function VisualizeObstacle(position, size)
    if not Config.ShowObstacles then return end
    
    local marker = Instance.new("Part")
    marker.Size = size or Vector3.new(2, 2, 2)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.Color = Config.ObstacleColor
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.5
    marker.Parent = workspace
    
    table.insert(State.visualizations, marker)
    
    task.delay(2, function()
        if marker and marker.Parent then
            marker:Destroy()
        end
    end)
end

-- ===================================
-- CORE RAYCASTING
-- ===================================

local function PerformRaycast(origin, direction, distance, useCache)
    useCache = useCache == nil and true or useCache
    
    -- Check cache
    if useCache then
        local cacheKey = CreateCacheKey(origin, direction, distance)
        local cached = State.raycastCache[cacheKey]
        if cached and (tick() - cached.time) < Config.CacheTimeout then
            Stats.cachedHits = Stats.cachedHits + 1
            return cached.result
        end
    end
    
    -- Create raycast params
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    local character = GetCharacter()
    if character then
        raycastParams.FilterDescendantsInstances = {character}
    end
    raycastParams.IgnoreWater = not Config.WaterDetection
    
    -- Perform raycast
    local result = workspace:Raycast(origin, direction * distance, raycastParams)
    Stats.totalRaycasts = Stats.totalRaycasts + 1
    
    -- Cache result
    if useCache then
        local cacheKey = CreateCacheKey(origin, direction, distance)
        State.raycastCache[cacheKey] = {
            result = result,
            time = tick()
        }
    end
    
    return result
end

-- ===================================
-- PART CLASSIFICATION + MOVEMENT ANALYSIS
-- ===================================

local IsKillbrick
local IsWater
local IsLava

local function TextMatchesAny(text, needles)
    if not text then return false end
    text = tostring(text):lower()

    for _, needle in ipairs(needles) do
        if text:find(needle, 1, true) then
            return true
        end
    end

    return false
end

local function GetSafeTags(instance)
    local ok, tags = pcall(function()
        return CollectionService:GetTags(instance)
    end)

    if ok and tags then
        return tags
    end

    return {}
end

local function GetAttributeText(instance)
    local pieces = {}
    local names = {"Type", "PartType", "AIType", "PathType", "Role", "Kind", "Hazard", "Climbable"}

    for _, name in ipairs(names) do
        local ok, value = pcall(function()
            return instance:GetAttribute(name)
        end)

        if ok and value ~= nil then
            table.insert(pieces, tostring(value))
        end
    end

    return table.concat(pieces, " ")
end

local function GetScriptHints(instance)
    if not Config.InspectScriptNames and not Config.InspectScriptSource then
        return ""
    end

    local hints = {}
    local checkedSources = 0

    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") then
            if Config.InspectScriptNames then
                table.insert(hints, descendant.Name)
            end

            if Config.InspectScriptSource and checkedSources < Config.MaxScriptSourceChecks then
                checkedSources = checkedSources + 1
                local ok, source = pcall(function()
                    return descendant.Source
                end)

                if ok and source then
                    table.insert(hints, source:sub(1, 1200))
                end
            end
        end
    end

    return table.concat(hints, " ")
end

local function GetInstanceSignalText(instance)
    if not instance then return "" end

    local pieces = {}
    local current = instance
    local depth = 0

    while current and current ~= workspace and depth < 5 do
        table.insert(pieces, current.Name)
        table.insert(pieces, current.ClassName)
        table.insert(pieces, GetAttributeText(current))

        for _, tag in ipairs(GetSafeTags(current)) do
            table.insert(pieces, tag)
        end

        current = current.Parent
        depth = depth + 1
    end

    table.insert(pieces, GetScriptHints(instance))

    return table.concat(pieces, " ")
end

function RaycastingVision.ClassifyInstance(instance)
    local result = {
        type = "unknown",
        isLadder = false,
        isClimbable = false,
        isHazard = false,
        isKillbrick = false,
        isWater = false,
        isJumpable = false,
        isObstacle = false,
        confidence = 0,
        reason = nil,
        instance = instance
    }

    if not instance then
        return result
    end

    local signalText = GetInstanceSignalText(instance)
    local ladderWords = {"ladder", "truss", "climb", "climbable", "rung"}
    local hazardWords = {"kill", "death", "lava", "void", "hazard", "damage", "deadly", "acid", "spike"}
    local waterWords = {"water", "swim"}
    local jumpWords = {"jump", "ledge", "gap", "step", "stair", "stairs", "platform", "obby"}

    if instance:IsA("TrussPart") or TextMatchesAny(signalText, ladderWords) then
        result.type = "ladder"
        result.isLadder = true
        result.isClimbable = true
        result.confidence = instance:IsA("TrussPart") and 1 or 0.75
        result.reason = instance:IsA("TrussPart") and "truss_part" or "ladder_signal"
        return result
    end

    if Config.KillbrickDetection and (IsKillbrick(instance) or TextMatchesAny(signalText, hazardWords)) then
        result.type = "hazard"
        result.isHazard = true
        result.isKillbrick = true
        result.confidence = 0.85
        result.reason = "hazard_signal"
        Stats.hazardsClassified = Stats.hazardsClassified + 1
        return result
    end

    if IsWater(instance, instance:IsA("BasePart") and instance.Material or nil) or TextMatchesAny(signalText, waterWords) then
        result.type = "water"
        result.isHazard = true
        result.isWater = true
        result.confidence = 0.7
        result.reason = "water_signal"
        return result
    end

    if IsLava(instance) then
        result.type = "hazard"
        result.isHazard = true
        result.confidence = 0.9
        result.reason = "lava_signal"
        Stats.hazardsClassified = Stats.hazardsClassified + 1
        return result
    end

    if TextMatchesAny(signalText, jumpWords) then
        result.type = "jumpable"
        result.isJumpable = true
        result.isObstacle = true
        result.confidence = 0.55
        result.reason = "jump_signal"
        return result
    end

    if instance:IsA("BasePart") and instance.CanCollide then
        result.type = "obstacle"
        result.isObstacle = true
        result.confidence = 0.35
        result.reason = "collidable_part"
    end

    return result
end

local function AddInteractiveHit(results, rayResult, origin, kind)
    if not rayResult or not rayResult.Instance then
        return
    end

    local classification = RaycastingVision.ClassifyInstance(rayResult.Instance)
    local hit = {
        position = rayResult.Position,
        normal = rayResult.Normal,
        instance = rayResult.Instance,
        distance = (rayResult.Position - origin).Magnitude,
        kind = kind or "scan",
        classification = classification
    }

    if classification.isLadder then
        table.insert(results.ladders, hit)
        Stats.laddersDetected = Stats.laddersDetected + 1

        if not results.nearestLadder or hit.distance < results.nearestLadder.distance then
            results.nearestLadder = hit
        end
    elseif classification.isHazard then
        table.insert(results.hazards, hit)
    elseif classification.isJumpable then
        table.insert(results.jumpables, hit)
    elseif classification.isObstacle then
        table.insert(results.obstacles, hit)
    end
end

function RaycastingVision.ScanForInteractives(radius, rayCount, includeDomeMap)
    radius = radius or Config.InteractiveScanRadius
    rayCount = rayCount or Config.InteractiveRayCount

    local rootPart = GetRootPart()
    if not rootPart then return nil end

    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local results = {
        ladders = {},
        hazards = {},
        jumpables = {},
        obstacles = {},
        nearestLadder = nil
    }

    for i = 0, rayCount - 1 do
        local yaw = (math.pi * 2 / rayCount) * i
        local flat = Vector3.new(math.cos(yaw), 0, math.sin(yaw))

        for _, pitch in ipairs({0, 0.35, -0.25}) do
            local direction = Vector3.new(flat.X, pitch, flat.Z).Unit
            local rayResult = PerformRaycast(origin, direction, radius, false)
            AddInteractiveHit(results, rayResult, origin, "direct")
        end
    end

    if includeDomeMap then
        for _, entry in pairs(State.domeMap) do
            if entry.instance then
                local classification = RaycastingVision.ClassifyInstance(entry.instance)
                if classification.isLadder or classification.isHazard or classification.isJumpable then
                    local hit = {
                        position = entry.position,
                        normal = entry.normal,
                        instance = entry.instance,
                        distance = (entry.position - origin).Magnitude,
                        kind = "dome_map",
                        classification = classification
                    }

                    if classification.isLadder then
                        table.insert(results.ladders, hit)
                        if not results.nearestLadder or hit.distance < results.nearestLadder.distance then
                            results.nearestLadder = hit
                        end
                    elseif classification.isHazard then
                        table.insert(results.hazards, hit)
                    elseif classification.isJumpable then
                        table.insert(results.jumpables, hit)
                    end
                end
            end
        end
    end

    return results
end

function RaycastingVision.AnalyzeMovementSegment(startPos, endPos)
    Stats.movementAnalyses = Stats.movementAnalyses + 1

    local direction = endPos - startPos
    local distance = direction.Magnitude
    if distance < 0.1 then
        return {needsJump = false, hasHazard = false}
    end

    direction = direction.Unit
    local sampleDistance = math.min(distance, Config.InteractiveScanRadius)
    local step = math.max(0.75, Config.MovementAnalysisStep)
    local heightDiff = endPos.Y - startPos.Y
    local analysis = {
        needsJump = false,
        jumpType = nil,
        reason = nil,
        hasHazard = false,
        hazard = nil,
        ladder = nil,
        obstacle = nil,
        voidStart = nil,
        voidLength = 0
    }

    if heightDiff > 4 then
        analysis.needsJump = true
        analysis.jumpType = "high_jump"
        analysis.reason = "height_diff"
    elseif heightDiff > 1.2 then
        analysis.needsJump = true
        analysis.jumpType = "normal"
        analysis.reason = "small_ledge"
    end

    local waistOrigin = startPos + Vector3.new(0, Config.MovementAnalysisHeight, 0)
    local waistHit = PerformRaycast(waistOrigin, direction, math.min(sampleDistance, 9), false)
    if waistHit then
        local classification = RaycastingVision.ClassifyInstance(waistHit.Instance)
        if classification.isLadder then
            analysis.ladder = {
                position = waistHit.Position,
                normal = waistHit.Normal,
                instance = waistHit.Instance,
                classification = classification,
                distance = (waistHit.Position - waistOrigin).Magnitude
            }
            return analysis
        elseif classification.isHazard then
            analysis.hasHazard = true
            analysis.hazard = waistHit
        elseif classification.isObstacle and (waistHit.Position - waistOrigin).Magnitude < 4 then
            analysis.needsJump = true
            analysis.jumpType = "normal"
            analysis.reason = "low_obstacle"
            analysis.obstacle = waistHit
        end
    end

    local voidStart = nil
    local voidLength = 0
    local samples = math.floor(sampleDistance / step)

    for i = 1, samples do
        local point = startPos + (direction * (i * step))
        local hasGround = RaycastingVision.CheckGround(point, 20)

        if not hasGround then
            if not voidStart then
                voidStart = i * step
            end
            voidLength = voidLength + step
        elseif voidStart then
            break
        end
    end

    if voidStart then
        analysis.needsJump = true
        analysis.jumpType = "gap_jump"
        analysis.reason = "void_gap"
        analysis.voidStart = voidStart
        analysis.voidLength = voidLength
    end

    return analysis
end

-- ===================================
-- BACKGROUND DOME + REFLECTION MAPPING
-- ===================================

local function ClampNumber(value, minValue, maxValue)
    if value < minValue then return minValue end
    if value > maxValue then return maxValue end
    return value
end

local function GetMapCellKey(position)
    local cellSize = math.max(1, Config.DomeMapCellSize)
    return tostring(math.floor(position.X / cellSize)) .. "," ..
           tostring(math.floor(position.Y / cellSize)) .. "," ..
           tostring(math.floor(position.Z / cellSize))
end

local function PruneDomeMap()
    local now = tick()
    local newOrder = {}
    local count = 0

    for _, key in ipairs(State.domeMapOrder) do
        local entry = State.domeMap[key]
        if entry and (now - entry.lastSeen) <= Config.DomeMapEntryTTL then
            table.insert(newOrder, key)
            count = count + 1
        else
            State.domeMap[key] = nil
        end
    end

    State.domeMapOrder = newOrder

    while count > Config.DomeMapMaxEntries and #State.domeMapOrder > 0 do
        local oldestKey = table.remove(State.domeMapOrder, 1)
        if State.domeMap[oldestKey] then
            State.domeMap[oldestKey] = nil
            count = count - 1
        end
    end
end

local function StoreDomeHit(origin, direction, result, kind, bounceIndex, sourceKey)
    if not result then return nil end

    local key = GetMapCellKey(result.Position)
    local now = tick()
    local entry = State.domeMap[key]

    if not entry then
        entry = {
            key = key,
            position = result.Position,
            normal = result.Normal,
            instance = result.Instance,
            material = result.Material,
            distance = (result.Position - origin).Magnitude,
            firstSeen = now,
            lastSeen = now,
            hits = 0,
            kind = kind,
            bounce = bounceIndex or 0,
            sourceKey = sourceKey
        }
        State.domeMap[key] = entry
        table.insert(State.domeMapOrder, key)
    else
        entry.position = result.Position
        entry.normal = result.Normal
        entry.instance = result.Instance
        entry.material = result.Material
        entry.distance = (result.Position - origin).Magnitude
        entry.lastSeen = now
        entry.kind = kind
        entry.bounce = bounceIndex or entry.bounce or 0
        entry.sourceKey = sourceKey or entry.sourceKey
    end

    entry.hits = entry.hits + 1

    if sourceKey then
        table.insert(State.reflectionEdges, {
            from = sourceKey,
            to = key,
            bounce = bounceIndex or 1,
            time = now
        })

        if #State.reflectionEdges > Config.DomeMapMaxEntries then
            table.remove(State.reflectionEdges, 1)
        end
    end

    return key, entry
end

local function GetDomeDirection(rayIndex)
    local horizontalSteps = math.max(4, Config.DomeHorizontalSteps)
    local verticalSteps = math.max(2, Config.DomeVerticalSteps)
    local totalSteps = horizontalSteps * verticalSteps
    local index = rayIndex % totalSteps
    local yawIndex = index % horizontalSteps
    local pitchIndex = math.floor(index / horizontalSteps)

    local yaw = (math.pi * 2 / horizontalSteps) * yawIndex
    local pitchAlpha = verticalSteps == 1 and 0.5 or (pitchIndex / (verticalSteps - 1))
    local pitchMin = math.rad(Config.DomePitchMin)
    local pitchMax = math.rad(Config.DomePitchMax)
    local pitch = pitchMin + ((pitchMax - pitchMin) * pitchAlpha)
    local horizontal = math.cos(pitch)

    return Vector3.new(math.cos(yaw) * horizontal, math.sin(pitch), math.sin(yaw) * horizontal).Unit
end

local function ReflectDirection(direction, normal)
    -- Back-face hit: ray came through the inside of a surface so the normal
    -- points the same way as the ray.  Reflecting in this case produces a
    -- bogus direction, so skip it entirely.
    if direction:Dot(normal) >= 0 then
        return nil
    end
    local reflected = direction - (2 * direction:Dot(normal) * normal)
    if reflected.Magnitude < 0.001 then
        return nil
    end
    return reflected.Unit
end

local function TraceDomeRay(origin, direction, shouldReflect)
    local castsUsed = 1
    local result = PerformRaycast(origin, direction, Config.DomeScanRadius, false)
    local sourceKey = StoreDomeHit(origin, direction, result, "primary", 0, nil)

    VisualizeRay(origin, direction, Config.DomeScanRadius, result, Config.RayColor)

    if result then
        Stats.domeHits = Stats.domeHits + 1
    end

    if not result or not shouldReflect or not Config.ReflectionMappingEnabled then
        return castsUsed
    end

    -- Only reflect off walls (vertical normals) not floors/ceilings.
    -- Floor/ceiling hits have a high Y component on their normal; reflecting
    -- off them just sends the ray bouncing vertically and it never travels
    -- far horizontally down corridors.
    if math.abs(result.Normal.Y) > 0.7 then
        return castsUsed
    end

    local bounceOrigin = result.Position + (result.Normal * Config.ReflectionSurfaceOffset)
    local bounceDirection = ReflectDirection(direction, result.Normal)

    for bounce = 1, Config.ReflectionBounceCount do
        if not bounceDirection then
            break
        end

        castsUsed = castsUsed + 1
        Stats.reflectionRays = Stats.reflectionRays + 1

        local bounceResult = PerformRaycast(bounceOrigin, bounceDirection, Config.ReflectionDistance, false)
        VisualizeRay(bounceOrigin, bounceDirection, Config.ReflectionDistance, bounceResult, Config.ReflectionColor)

        local nextKey = StoreDomeHit(bounceOrigin, bounceDirection, bounceResult, "reflection", bounce, sourceKey)
        if bounceResult then
            Stats.reflectionHits = Stats.reflectionHits + 1
        end

        if not bounceResult then
            -- Ray traveled full ReflectionDistance without hitting anything
            -- (open corridor end) — nothing more to bounce off, stop here.
            break
        end

        -- Skip reflecting off floors/ceilings mid-bounce too
        if math.abs(bounceResult.Normal.Y) > 0.7 then
            break
        end

        sourceKey = nextKey or sourceKey
        bounceOrigin = bounceResult.Position + (bounceResult.Normal * Config.ReflectionSurfaceOffset)
        bounceDirection = ReflectDirection(bounceDirection, bounceResult.Normal)
    end

    return castsUsed
end

local function ApplyDomeOptions(options)
    if not options then return end

    local optionMap = {
        radius = "DomeScanRadius",
        horizontalSteps = "DomeHorizontalSteps",
        verticalSteps = "DomeVerticalSteps",
        pitchMin = "DomePitchMin",
        pitchMax = "DomePitchMax",
        raysPerStep = "DomeRaysPerStep",
        stepWait = "DomeStepWait",
        reflectionBounces = "ReflectionBounceCount",
        reflectionDistance = "ReflectionDistance",
        reflectionEvery = "ReflectionEveryNRays",
        enabled = "DomeMappingEnabled"
    }

    for key, value in pairs(options) do
        local configKey = optionMap[key] or key
        if Config[configKey] ~= nil then
            Config[configKey] = value
        end
    end
end

function RaycastingVision.StepDomeMapping(rayBudget)
    if not Config.DomeMappingEnabled then
        return nil
    end

    local rootPart = GetRootPart()
    if not rootPart then
        return nil
    end

    rayBudget = rayBudget or Config.DomeRaysPerStep
    rayBudget = ClampNumber(math.floor(rayBudget), 1, Config.MaxRaysPerFrame)

    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local horizontalSteps = math.max(4, Config.DomeHorizontalSteps)
    local verticalSteps = math.max(2, Config.DomeVerticalSteps)
    local totalSteps = horizontalSteps * verticalSteps
    local castsUsed = 0
    local primaryRays = 0
    local startedAt = State.domeRayIndex

    while castsUsed < rayBudget do
        local direction = GetDomeDirection(State.domeRayIndex)
        local shouldReflect = Config.ReflectionEveryNRays <= 1 or (State.domeRayIndex % Config.ReflectionEveryNRays == 0)
        castsUsed = castsUsed + TraceDomeRay(origin, direction, shouldReflect)
        primaryRays = primaryRays + 1
        State.domeRayIndex = (State.domeRayIndex + 1) % totalSteps

        if State.domeRayIndex == 0 and startedAt ~= 0 then
            Stats.domeSweeps = Stats.domeSweeps + 1
            State.lastDomeSweep = tick()
            break
        end
    end

    PruneDomeMap()

    State.lastDomeSummary = {
        primaryRays = primaryRays,
        raycasts = castsUsed,
        mappedCells = #State.domeMapOrder,
        reflectionEdges = #State.reflectionEdges,
        nextIndex = State.domeRayIndex,
        time = tick()
    }

    return State.lastDomeSummary
end

function RaycastingVision.StartDomeMapping(options)
    ApplyDomeOptions(options)

    if State.mappingActive then
        return true
    end

    State.mappingActive = true
    State.mappingGeneration = State.mappingGeneration + 1
    local generation = State.mappingGeneration

    task.spawn(function()
        while State.mappingActive and State.mappingGeneration == generation do
            local ok, err = pcall(function()
                RaycastingVision.StepDomeMapping(Config.DomeRaysPerStep)
            end)

            if not ok then
                Log("Dome mapping step failed: " .. tostring(err), "WARN")
            end

            task.wait(Config.DomeStepWait)
        end
    end)

    Log("Background dome mapping started")
    return true
end

function RaycastingVision.StopDomeMapping()
    State.mappingActive = false
    State.mappingGeneration = State.mappingGeneration + 1
    Log("Background dome mapping stopped")
end

function RaycastingVision.IsDomeMappingActive()
    return State.mappingActive
end

function RaycastingVision.ClearDomeMap()
    State.domeMap = {}
    State.domeMapOrder = {}
    State.reflectionEdges = {}
    State.lastDomeSummary = nil
    Log("Dome map cleared")
end

function RaycastingVision.GetDomeMap()
    return State.domeMap
end

function RaycastingVision.GetReflectionEdges()
