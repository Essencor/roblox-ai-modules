local function Destroy3DParts()
    for _, p in ipairs(State.noclip3DPartPool) do
        pcall(function() if p and p.Parent then p:Destroy() end end)
    end
    State.noclip3DPartPool = {}
end

local function Update3DVisualization()
    if not Config.NoclipVisualize3D then
        if #State.noclip3DPartPool > 0 then Destroy3DParts() end
        return
    end

    if tick() - State.noclipLast3DUpdate < Config.NoclipVisualize3DUpdateInterval then return end
    State.noclipLast3DUpdate = tick()

    local rootPart = GetRootPart()
    if not rootPart then return end

    local charPos  = rootPart.Position
    local radius   = Config.NoclipVisualize3DRadius
    local maxParts = Config.NoclipVisualize3DMaxParts
    local pSize    = Config.NoclipVisualize3DSize

    -- Gather nearby unified cells (all sources, unfiltered for 3D)
    local nearby = {}
    for _, entry in pairs(State.unifiedMap) do
        local dist = (entry.position - charPos).Magnitude
        if dist <= radius then
            table.insert(nearby, {pos = entry.position, color = entry.color, dist = dist})
        end
    end
    table.sort(nearby, function(a, b) return a.dist < b.dist end)

    local count = math.min(#nearby, maxParts)

    -- Hide extras
    for i = count + 1, #State.noclip3DPartPool do
        local p = State.noclip3DPartPool[i]
        if p and p.Parent then p.Transparency = 1 end
    end

    for i = 1, count do
        local cell = nearby[i]
        local part = State.noclip3DPartPool[i]

        if not part or not part.Parent then
            part              = Instance.new("Part")
            part.Shape        = Enum.PartType.Ball
            part.Size         = Vector3.new(pSize, pSize, pSize)
            part.Anchored     = true
            part.CanCollide   = false
            part.CanQuery     = false
            part.CanTouch     = false
            part.CastShadow   = false
            part.Material     = Enum.Material.Neon
            part.Parent       = workspace
            State.noclip3DPartPool[i] = part
        end

        part.CFrame      = CFrame.new(cell.pos)
        part.Color       = cell.color
        part.Transparency = 0.25
    end
end

