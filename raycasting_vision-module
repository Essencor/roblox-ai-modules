local function Log(message, level)
    level = level or "INFO"
    print("[RaycastVision:" .. level .. "] " .. tostring(message))
end

local function IsNavigationBoostActive()
    return Config.NavigationBoostEnabled and State.navigationBoostActive
end

local function IsTerrainInstance(instance)
    return instance ~= nil and instance.ClassName == "Terrain"
end

local function IsTerrainGroundHit(result)
    return Config.TerrainFriendlyMode
        and result ~= nil
        and IsTerrainInstance(result.Instance)
        and result.Normal
        and result.Normal.Y >= Config.TerrainGroundNormalY
end

local function NoteTerrainHit(result)
    if result and IsTerrainInstance(result.Instance) then
        Stats.terrainHits = Stats.terrainHits + 1
        State.terrainModeUntil = tick() + 4
    end
end

local function IsTerrainModeActive()
    return Config.TerrainFriendlyMode and tick() < (State.terrainModeUntil or 0)
end

local function GetDomeStepSettings()
    if IsNavigationBoostActive() then
        if IsTerrainModeActive() then
            return Config.TerrainBoostDomeRaysPerStep, Config.TerrainBoostDomeStepWait, Config.TerrainBoostDomeStepTimeBudget
        end
        return Config.NavigationDomeRaysPerStep, Config.NavigationDomeStepWait, Config.NavigationDomeStepTimeBudget
    end
    return Config.DomeRaysPerStep, Config.DomeStepWait, Config.DomeStepTimeBudget
end

local function GetNoclipStepSettings()
    if IsNavigationBoostActive() then
        if IsTerrainModeActive() then
            return Config.TerrainBoostNoclipRaysPerStep, Config.TerrainBoostNoclipStepWait, Config.TerrainBoostNoclipStepTimeBudget
        end
        return Config.NavigationNoclipRaysPerStep, Config.NavigationNoclipStepWait, Config.NavigationNoclipStepTimeBudget
    end
    return Config.NoclipRaysPerStep, Config.NoclipStepWait, Config.NoclipStepTimeBudget
end

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRootPart()
    local character = GetCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function CreateCacheKey(origin, direction, distance)
    return tostring(math.floor(origin.X)) .. "," .. tostring(math.floor(origin.Y)) .. "," .. tostring(math.floor(origin.Z)) .. "_" ..
           tostring(math.floor(direction.X * 100)) .. "," .. tostring(math.floor(direction.Y * 100)) .. "," .. tostring(math.floor(direction.Z * 100)) .. "_" ..
           tostring(math.floor(distance))
end

