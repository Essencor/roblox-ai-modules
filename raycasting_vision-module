local function UpdateNoclipMapDisplay()
    if not Config.NoclipVisualizeShape then
        if State.noclipMapGui then DestroyNoclipMapGui() end
        return
    end

    if not State.noclipMapGui then CreateNoclipMapGui() end
    if not State.noclipMapGui then return end

    if tick() - State.noclipLastMapUpdate < Config.NoclipMapUpdateInterval then return end
    State.noclipLastMapUpdate = tick()

    local rootPart = GetRootPart()
    if not rootPart then return end

    local gui        = State.noclipMapGui
    local canvas     = gui.canvas
    local viewR      = Config.NoclipMapViewRadius
    local cellSize   = math.max(1, Config.NoclipCellSize)
    local charPos    = rootPart.Position

    -- In fullscreen mode use the actual canvas pixel size; in minimap use config size
    local fullscreen = gui.isFullscreen and gui.isFullscreen()
    local ds = fullscreen
        and math.min(canvas.AbsoluteSize.X, canvas.AbsoluteSize.Y)
        or  Config.NoclipMapDisplaySize

    -- Pixel size in screen-space — bigger canvas = bigger dots
    local pxPerCell = math.max(1, math.floor(ds / (viewR * 2 / cellSize)))

    -- Collect visible cells from UNIFIED map (all 3 sources combined).
    -- 2D filter: skip floor/ceiling hits and anything too far below torso.
    local minY   = charPos.Y - Config.NoclipTorsoFilterOffset
    local visible = {}
    for _, entry in pairs(State.unifiedMap) do
        local pos = entry.position
        local dx  = pos.X - charPos.X
        local dz  = pos.Z - charPos.Z
        if math.abs(dx) <= viewR and math.abs(dz) <= viewR then
            -- Floor/ceiling filter (noclip entries carry normals)
            local n = entry.normal
            if n and math.abs(n.Y) > 0.7 then continue end
            -- Below-torso filter (only for noclip; dome/reflection are wall-only already)
            if entry.source == "noclip" and pos.Y < minY then continue end
            local px = math.floor((dx / viewR + 1) * 0.5 * (ds - pxPerCell))
            local py = math.floor((dz / viewR + 1) * 0.5 * (ds - pxPerCell))
            table.insert(visible, {px = px, py = py, color = entry.color})
        end
    end

    -- Hide all pooled pixels first
    for _, dot in ipairs(State.noclipPixelPool) do
        dot.Visible = false
    end

    -- Reuse / grow pixel pool
    for i, cell in ipairs(visible) do
        local dot = State.noclipPixelPool[i]
        if not dot then
            dot = Instance.new("Frame")
            dot.BorderSizePixel = 0
            dot.ZIndex          = 3
            dot.Parent          = canvas
            State.noclipPixelPool[i] = dot
        end
        dot.Size             = UDim2.new(0, pxPerCell, 0, pxPerCell)
        dot.Position         = UDim2.new(0, cell.px, 0, cell.py)
        dot.BackgroundColor3 = cell.color
        dot.Visible          = true
    end
end

