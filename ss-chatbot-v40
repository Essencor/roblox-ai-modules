-- SS Chatbot v40 bootstrap
-- Fresh path to avoid raw.githubusercontent.com cache lag on older loader files.

local LOADER_URL = "https://raw.githubusercontent.com/Essencor/roblox-ai-modules/main/ss-chatbot?fresh=v40-20260601-0205"

local okFetch, source = pcall(function()
	return game:HttpGet(LOADER_URL, true)
end)

if not okFetch then
	error("[SS Chatbot] bootstrap HttpGet failed: " .. tostring(source))
end

local chunk, compileErr = loadstring(source)
if not chunk then
	error("[SS Chatbot] bootstrap compile failed: " .. tostring(compileErr))
end

return chunk()
