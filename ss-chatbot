	function()
		return [[-- Add memory context if user is specified
   if username then
      local userHistory = Memory:GetUserHistory(username, 6)

      if userHistory ~= "" then
         local contextName = displayName or username
         finalPrompt = finalPrompt .. "\n\nConversation history with " .. contextName .. ":\n" .. userHistory
      end

      local function sharedMemoryMatches(message, query)
         local msg = tostring(message or ""):lower()
         local q = tostring(query or ""):lower()
         for word in q:gmatch("%w+") do
            if #word >= 3 and msg:find(word, 1, true) then
               return true
            end
         end
         return false
      end

      local sharedRelevant = {}
      local sharedRecent = {}
      for i = #Memory.GlobalMemory, 1, -1 do
         local entry = Memory.GlobalMemory[i]
         if entry and entry.username ~= username then
            local speaker = entry.isAI and ("AI to " .. tostring(entry.username)) or tostring(entry.username)
            local line = speaker .. ": " .. tostring(entry.message):sub(1, 120)

            if #sharedRecent < 4 then
               table.insert(sharedRecent, line)
            end

            if #sharedRelevant < 5 and sharedMemoryMatches(entry.message, userMessage) then
               table.insert(sharedRelevant, line)
            end

            if #sharedRecent >= 4 and #sharedRelevant >= 5 then
               break
            end
         end
      end

      if #sharedRelevant > 0 or #sharedRecent > 0 then
         finalPrompt = finalPrompt .. "\n\nShared memory from other players:\n"

         if #sharedRelevant > 0 then
            finalPrompt = finalPrompt .. "Relevant:\n"
