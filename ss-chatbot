local function getRequestFunction()
	return (syn and syn.request)
		or (http and http.request)
		or http_request
		or request
end

local function requestJson(url, headers, body)
	local requestFn = getRequestFunction()

	if requestFn then
		local response = requestFn({
			Url = url,
			Method = "POST",
			Headers = headers,
			Body = body,
		})

		if type(response) == "table" then
			return response.Success ~= false, response.Body or "", response.StatusCode or 0
		end

		return false, tostring(response), 0
	end

	local ok, response = pcall(function()
		return HttpService:RequestAsync({
			Url = url,
			Method = "POST",
			Headers = headers,
			Body = body,
		})
	end)

	if ok and type(response) == "table" then
		return response.Success ~= false, response.Body or "", response.StatusCode or 0
	end

	return false, tostring(response), 0
end

local function getGeneralChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")
	if not channels then
		return nil
	end

	return channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel")
end

local function showInChat(text)
	local channel = getGeneralChannel()
	if channel and channel.DisplaySystemMessage then
		pcall(function()
			channel:DisplaySystemMessage(text)
		end)
		return
	end

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = text,
			Color = Color3.fromRGB(120, 205, 255),
			Font = Enum.Font.SourceSansBold,
			TextSize = 18,
		})
	end)
end

local function sendToChat(text)
	local channel = getGeneralChannel()
	if channel and channel.SendAsync then
		local ok = pcall(function()
			channel:SendAsync(text)
		end)
		if ok then
			return
		end
	end

	showInChat(text)
end

local function trimForChat(text)
	text = tostring(text or ""):gsub("%s+", " ")
	if #text > 180 then
		text = text:sub(1, 177) .. "..."
	end
	return text
end

local function getAIResponse(prompt)
	if Config.ApiKey == "" then
		return nil, "Add your OpenRouter API key in Setup first."
	end

	local payload = HttpService:JSONEncode({
		model = Config.Model,
		messages = {
			{ role = "system", content = Config.SystemPrompt },
			{ role = "user", content = prompt },
		},
		temperature = 0.7,
		max_tokens = 120,
	})

	local ok, body, status = requestJson(
		"https://openrouter.ai/api/v1/chat/completions",
		{
			["Authorization"] = "Bearer " .. Config.ApiKey,
			["Content-Type"] = "application/json",
			["HTTP-Referer"] = "https://github.com/Essencor/roblox-ai-modules",
			["X-Title"] = "SS Chatbot",
		},
		payload
	)

	if not ok then
		return nil, "Request failed: " .. tostring(body) .. " (" .. tostring(status) .. ")"
	end

	local decodedOk, decoded = pcall(function()
		return HttpService:JSONDecode(body)
	end)

	if not decodedOk then
		return nil, "OpenRouter returned invalid JSON."
	end

	local message = decoded and decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content
	if type(message) ~= "string" or message == "" then
		local apiError = decoded and decoded.error and decoded.error.message
		return nil, apiError or "OpenRouter returned no message."
	end

	return trimForChat(message)
end

local function askBot(prompt, speakerName, sendPublic)
	prompt = tostring(prompt or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if prompt == "" then
		setStatus("enter a prompt first")
		return
	end

	if Config.Busy then
		setStatus("already thinking")
		return
	end

	local now = os.clock()
	if now - Config.LastReply < Config.Cooldown then
		setStatus("cooldown active")
		return
	end

	Config.Busy = true
	Config.LastReply = now
	setStatus("thinking")

	task.spawn(function()
		local answer, err = getAIResponse(prompt)
		Config.Busy = false

		if not answer then
			local text = err or "No response."
			LastReplyLabel:Set("Last reply: " .. text)
			setStatus("error")
			notify("SS Chatbot Error", text)
			showInChat("[SS Chatbot] " .. text)
			return
		end

		local label = Config.BotName
		if speakerName and speakerName ~= "" then
			label = label .. " to " .. speakerName
		end

		local line = "[" .. label .. "] " .. answer
		LastReplyLabel:Set("Last reply: " .. line)
		setStatus("replied")

		if sendPublic then
			sendToChat(line)
		else
			showInChat(line)
		end
	end)
end

