local function NormalizeActionName(actionName)
   local action = tostring(actionName or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
   action = action:gsub("[^%a%s]", "")
   local aliases = {
      hop = "jump",
      leap = "jump",
      ["sit down"] = "sit",
      ["stand up"] = "stand",
      ["get up"] = "stand",
      boogie = "dance",
      ["come here"] = "follow",
      ["come to me"] = "follow",
      ["follow me"] = "follow",
      greet = "wave",
      greeting = "wave",
      hello = "wave",
      halt = "stop"
   }
   return aliases[action] or action
end

local function IsAllowedActionName(actionName)
   return actionName == "jump"
      or actionName == "sit"
      or actionName == "stand"
      or actionName == "dance"
      or actionName == "wave"
      or actionName == "point"
      or actionName == "cheer"
      or actionName == "laugh"
      or actionName == "follow"
      or actionName == "stop"
end

local function ParseActionTag(tagText)
   local raw = tostring(tagText or ""):lower():gsub("[{}%[%]\"']", " "):gsub("^%s+", ""):gsub("%s+$", "")
   raw = raw:gsub("^action%s*[:=]%s*", "")
   raw = raw:gsub("^name%s*[:=]%s*", "")

   local action, count = raw:match("^%s*([%a%s]+)%s*:%s*(%d+)%s*$")
   if not action then
      action, count = raw:match("^%s*([%a%s]+)%s*[=,;]%s*(%d+)%s*$")
   end
   if not action then
      action, count = raw:match("^%s*([%a%s]+)%s+(%d+)%s*$")
   end
   if not action then
      action, count = raw:match("^%s*([%a]+)(%d+)%s*$")
   end
   if not action then
      action = raw:match("^%s*([%a%s]+)%s*$")
   end

   action = NormalizeActionName(action)
   if not IsAllowedActionName(action) then
      warn("[SS Chatbot] Ignored unsupported AI action tag:", tostring(tagText))
      return nil
   end

   count = tonumber(count) or 1
   count = math.clamp(math.floor(count), 1, 50)
   return {
      action = action,
      count = count,
      keyword = action
   }
end

local function ExtractActionTags(message)
   local sequence = {}
   local cleaned = tostring(message or ""):gsub("<%s*ACTION%s*:([^>]+)>", function(tagText)
      local parsed = ParseActionTag(tagText)
      if parsed then
         table.insert(sequence, parsed)
      end
      return ""
   end)

   cleaned = cleaned:gsub("<%s*/?%s*ACTION%s*>", "")

   cleaned = cleaned:gsub("%s+$", "")
   return sequence, cleaned
end

-- Detect actions with quantities and sequences. Only direct user commands are parsed.
local function DetectSmartActions(message)
   if not IsLikelyDirectActionRequest(message) then
      return {}
   end

   local msg = tostring(message or ""):lower()
   local actionSequence = {}

   local actionPatterns = {
      jump = {"jump", "hop", "leap"},
      sit = {"sit down", "sit"},
      stand = {"stand up", "get up", "stand"},
      dance = {"dance", "boogie"},
      wave = {"wave"},
      point = {"point"},
      cheer = {"cheer"},
      laugh = {"laugh"},
      follow = {"follow me", "come here", "come to me"},
      stop = {"stop", "halt"}
   }

   for action, keywords in pairs(actionPatterns) do
      for _, keyword in ipairs(keywords) do
         if msg:find(keyword, 1, true) then
            local count = ExtractNumber(msg, keyword)
            count = math.min(count, 50)
            table.insert(actionSequence, {
               action = action,
               count = count,
               keyword = keyword
            })
            break
         end
      end
   end

   table.sort(actionSequence, function(a, b)
      local posA = msg:find(a.keyword, 1, true) or 9999
      local posB = msg:find(b.keyword, 1, true) or 9999
      return posA < posB
   end)

   return actionSequence
end

