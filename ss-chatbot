local function shouldAnswer(message)
	message = tostring(message or "")
	local lower = string.lower(message)
	local prefix = string.lower(Config.Prefix)

	if string.sub(lower, 1, #prefix) == prefix then
		return true, message:sub(#Config.Prefix + 1)
	end

	if string.find(lower, string.lower(Config.BotName), 1, true) then
		return true, message
	end

	return false, nil
end

local function handleMessage(player, message)
	if not Config.Enabled then
		return
	end

	if not player or player == LocalPlayer then
		return
	end

	local matches, prompt = shouldAnswer(message)
	if matches then
		askBot(prompt, player.DisplayName or player.Name, true)
	end
end

local function connectPlayer(player)
	player.Chatted:Connect(function(message)
		handleMessage(player, message)
	end)
end

print("[SS Chatbot] 5/6 connecting chat")
for _, player in ipairs(Players:GetPlayers()) do
	connectPlayer(player)
end
Players.PlayerAdded:Connect(connectPlayer)

pcall(function()
	TextChatService.MessageReceived:Connect(function(message)
		local source = message.TextSource
		if not source then
			return
		end

		local player = Players:GetPlayerByUserId(source.UserId)
		handleMessage(player, message.Text)
	end)
end)

