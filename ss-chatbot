local function getAIResponse(prompt)
	if Config.ApiKey == nil or Config.ApiKey == "" then
		return nil, "Put your OpenRouter API key in the box first."
	end

	local body = HttpService:JSONEncode({
		model = Config.Model,
		messages = {
			{ role = "system", content = Config.SystemPrompt },
			{ role = "user", content = prompt },
		},
		temperature = 0.7,
		max_tokens = Config.MaxTokens,
	})

	local ok, response, statusCode = executorRequest(
		"https://openrouter.ai/api/v1/chat/completions",
		"POST",
		{
			["Authorization"] = "Bearer " .. Config.ApiKey,
			["Content-Type"] = "application/json",
			["HTTP-Referer"] = "https://github.com/Essencor/roblox-ai-modules",
			["X-Title"] = "SS Chatbot",
		},
		body
	)

	if not ok then
		return nil, "Request failed: " .. tostring(response) .. " (" .. tostring(statusCode) .. ")"
	end

	local decodedOk, decoded = pcall(function()
		return HttpService:JSONDecode(response)
	end)

	if not decodedOk then
		return nil, "OpenRouter returned invalid JSON."
	end

	local message = decoded and decoded.choices and decoded.choices[1] and decoded.choices[1].message and decoded.choices[1].message.content
	if type(message) ~= "string" or message == "" then
		local errorText = decoded and decoded.error and decoded.error.message
		return nil, errorText or "OpenRouter returned no message."
	end

	return clampChat(message)
end

local function askBot(prompt, speakerName, sendToChat)
	if pendingRequest then
		setStatus("Already thinking. Wait for this reply first.")
		return
	end

	if not Config.Enabled then
		setStatus("Bot is turned off.")
		return
	end

	local now = os.clock()
	if now - lastReplyAt < Config.Cooldown then
		setStatus("Cooldown active. Try again in a moment.")
		return
	end

	prompt = tostring(prompt or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if prompt == "" then
		setStatus("Type something for the bot first.")
		return
	end

	pendingRequest = true
	lastReplyAt = now
	setStatus("Thinking...")	
	Output.Text = "Thinking about: " .. prompt

	task.spawn(function()
		local answer, err = getAIResponse(prompt)
		pendingRequest = false

		if not answer then
			Output.Text = err or "No response."
			setStatus("Could not get a reply.")
			displayMessage("[SS Chatbot] " .. (err or "No response."))
			return
		end

		local prefix = Config.BotName
		if speakerName and speakerName ~= "" then
			prefix = prefix .. " to " .. speakerName
		end

		local line = "[" .. prefix .. "] " .. answer
		Output.Text = line
		setStatus("Replied.")

		if sendToChat then
			sendChatOrDisplay(line)
		else
			displayMessage(line)
		end
	end)
end

