local function patchNumericLoadstringChunks()
	if type(loadstring) ~= "function" then
		return
	end

	local env = (getgenv and getgenv()) or _G
	if not env.__SSChatbotOriginalLoadstring then
		env.__SSChatbotOriginalLoadstring = loadstring
	end

	local originalLoadstring = env.__SSChatbotOriginalLoadstring
	local function noop()
		return nil
	end

	local function noopFactory()
		return noop
	end

	local function guardedLoadstring(source, chunkName)
		if type(source) == "string" and source:match("^%s*%d+%s*$") then
			return function(...)
				return nil
			end
		end

		local isNumericChunk = type(chunkName) == "string" and chunkName:match("^%d+$")
		local chunk, compileErr = originalLoadstring(source, chunkName)
		if not chunk then
			if isNumericChunk then
				return function(...)
					warn("[SS Chatbot] skipped bad numeric asset chunk:", tostring(chunkName))
					return noop
				end
			end

			return nil, compileErr
		end

		if isNumericChunk then
			return function(...)
				local ok, result = pcall(chunk, ...)
				if not ok then
					local message = tostring(result)
					if message:find("attempt to call a nil value", 1, true) then
						warn("[SS Chatbot] skipped bad numeric asset chunk:", chunkName)
						return noop
					end

					error(message, 0)
				end

				if result == nil or type(result) == "number" then
					return noop
				end

				return result
			end
		end

		if type(setfenv) == "function" then
			pcall(setfenv, chunk, env)
		end

		return chunk
	end

	env.loadstring = guardedLoadstring
	env.load = guardedLoadstring
	_G.loadstring = guardedLoadstring
	_G.load = guardedLoadstring
	env.__SSChatbotNumericLoadstringPatched = true
	env.__SSChatbotNumericLoadstringPatchVersion = 2
	print("[SS Chatbot] patched numeric loadstring chunks")
	return guardedLoadstring
end

local okLoadstringPatch, guardedLoadstring = pcall(patchNumericLoadstringChunks)
if not okLoadstringPatch or type(guardedLoadstring) ~= "function" then
	guardedLoadstring = loadstring
end

local function makeGuardedEnvironment()
	local baseEnv = (getgenv and getgenv()) or _G
	local runtimeEnv = {}

	setmetatable(runtimeEnv, {
		__index = function(_, key)
			if key == "loadstring" or key == "load" then
				return guardedLoadstring
			end
			return baseEnv[key] or _G[key]
		end,
		__newindex = function(_, key, value)
			baseEnv[key] = value
			_G[key] = value
		end
	})

	runtimeEnv.loadstring = guardedLoadstring
	runtimeEnv.load = guardedLoadstring
	return runtimeEnv
end

