local function executorRequest(url, method, headers, body)
	local requestFn = (syn and syn.request) or (http and http.request) or http_request or request

	if requestFn then
		local response = requestFn({
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})

		if type(response) == "table" then
			return response.Success ~= false, response.Body or "", response.StatusCode or 0
		end

		return false, tostring(response), 0
	end

	local options = {
		Url = url,
		Method = method or "GET",
		Headers = headers or {},
	}

	if body then
		options.Body = body
	end

	local ok, response = pcall(function()
		return HttpService:RequestAsync(options)
	end)

	if ok and type(response) == "table" then
		return response.Success ~= false, response.Body or "", response.StatusCode or 0
	end

	return false, tostring(response), 0
end

local function getGeneralChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")
	if not channels then
		return nil
	end

	return channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel")
end

local function displayMessage(text)
	local channel = getGeneralChannel()
	if channel and channel.DisplaySystemMessage then
		pcall(function()
			channel:DisplaySystemMessage(text)
		end)
		return
	end

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = text,
			Color = Color3.fromRGB(120, 205, 255),
			Font = Enum.Font.SourceSansBold,
			TextSize = 18,
		})
	end)
end

local function sendChatOrDisplay(text)
	local channel = getGeneralChannel()
	if channel and channel.SendAsync then
		local ok = pcall(function()
			channel:SendAsync(text)
		end)
		if ok then
			return
		end
	end

	displayMessage(text)
end

local function clampChat(text)
	text = tostring(text or "")
	text = text:gsub("%s+", " ")
	if #text > 180 then
		text = text:sub(1, 177) .. "..."
	end
	return text
end

