local function patchNumericLoadstringChunks()
	if type(loadstring) ~= "function" then
		return
	end

	local env = (getgenv and getgenv()) or _G
	if env.__SSChatbotNumericLoadstringPatched then
		return
	end

	local originalLoadstring = loadstring
	local function guardedLoadstring(source, chunkName)
		if type(source) == "string" and source:match("^%s*%d+%s*$") then
			return function()
				return nil
			end
		end

		local isNumericChunk = type(chunkName) == "string" and chunkName:match("^%d+$")
		local chunk, compileErr = originalLoadstring(source, chunkName)
		if not chunk then
			if isNumericChunk then
				return function()
					warn("[SS Chatbot] skipped bad numeric asset chunk:", tostring(chunkName))
					return nil
				end
			end

			return nil, compileErr
		end

		if isNumericChunk then
			return function(...)
				local ok, result = pcall(chunk, ...)
				if not ok then
					local message = tostring(result)
					if message:find("attempt to call a nil value", 1, true) then
						warn("[SS Chatbot] skipped bad numeric asset chunk:", chunkName)
						return function() return nil end
					end

					error(message, 0)
				end

				return result
			end
		end

		return chunk
	end

	env.loadstring = guardedLoadstring
	_G.loadstring = guardedLoadstring
	env.__SSChatbotNumericLoadstringPatched = true
	print("[SS Chatbot] patched numeric loadstring chunks")
end

pcall(patchNumericLoadstringChunks)

local function patchEasySpriteSingleCellRange()
	local okService, ReplicatedStorage = pcall(function()
		return game:GetService("ReplicatedStorage")
	end)

	if not okService then
		return
	end

	local modules = ReplicatedStorage:FindFirstChild("Modules")
	local easySprite = modules and modules:FindFirstChild("EasySprite")
	local spriteSequencerModule = easySprite and easySprite:FindFirstChild("SpriteSequencer")

	if not spriteSequencerModule or not spriteSequencerModule:IsA("ModuleScript") then
		return
	end

	local okRequire, SpriteSequencer = pcall(require, spriteSequencerModule)
	if not okRequire or type(SpriteSequencer) ~= "table" or type(SpriteSequencer.fromRange) ~= "function" then
		return
	end

	if SpriteSequencer.__SSChatbotSingleCellRangePatched then
		return
	end

	local originalFromRange = SpriteSequencer.fromRange
	SpriteSequencer.fromRange = function(spriteSheet, fromCell, toCell)
		if fromCell == toCell then
			if type(SpriteSequencer.new) == "function" then
				return SpriteSequencer.new(spriteSheet, { fromCell })
			end

			if spriteSheet and type(spriteSheet.display) == "function" then
				spriteSheet.display(fromCell)
			end

			return {
				play = function() end,
				stop = function() end,
				isPlaying = function()
					return false
				end
			}
		end

		return originalFromRange(spriteSheet, fromCell, toCell)
	end

	SpriteSequencer.__SSChatbotSingleCellRangePatched = true
	print("[SS Chatbot] patched EasySprite single-cell ranges")
end

pcall(patchEasySpriteSingleCellRange)

