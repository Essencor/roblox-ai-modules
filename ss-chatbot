local function fetch(url)
	local ok, body = pcall(function()
		return game:HttpGet(url, true)
	end)

	if not ok or type(body) ~= "string" or body == "" then
		error("[SS Chatbot] Failed to fetch " .. url .. ": " .. tostring(body))
	end

	return body
end

local function loadUrl(url, label)
	local source = fetch(url)
	local chunk, compileErr = loadstring(source)
	if not chunk then
		error("[SS Chatbot] " .. label .. " compile failed: " .. tostring(compileErr))
	end

	local ok, result = pcall(chunk)
	if not ok then
		error("[SS Chatbot] " .. label .. " runtime failed: " .. tostring(result))
	end

	return result
end

