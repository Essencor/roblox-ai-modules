print("[SS Chatbot] entrypoint v8 started")

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
   Name = "SS Hub - AI Chatbot",
   LoadingTitle = "AI Chatbot",
   LoadingSubtitle = "loading original hub...",
   ConfigurationSaving = {
      Enabled = false
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false
})

local Tab = Window:CreateTab("Loader", 4483362458)
Tab:CreateParagraph({
   Title = "SS Chatbot Loader",
   Content = "The GitHub entrypoint loaded correctly. If you see this, the outer loadstring is working."
})

Tab:CreateButton({
   Name = "Load Original Hub",
   Callback = function()
      print("[SS Chatbot] fetching original hub")
      local source = game:HttpGet("https://raw.githubusercontent.com/Essencor/roblox-ai-modules/98bdb57616fe9e5278046129d034638813e5fc6b/ss-chatbot", true)
      local chunk, compileErr = loadstring(source)

      if not chunk then
         Rayfield:Notify({
            Title = "Compile Error",
            Content = tostring(compileErr),
            Duration = 8,
            Image = 4483362458
         })
         error("[SS Chatbot] original hub compile failed: " .. tostring(compileErr))
      end

      local ok, runtimeErr = pcall(chunk)
      if not ok then
         Rayfield:Notify({
            Title = "Runtime Error",
            Content = tostring(runtimeErr),
            Duration = 8,
            Image = 4483362458
         })
         error("[SS Chatbot] original hub runtime failed: " .. tostring(runtimeErr))
      end
   end
})

Rayfield:Notify({
   Title = "SS Chatbot Loaded",
   Content = "Entrypoint v8 loaded. Press Load Original Hub.",
   Duration = 5,
   Image = 4483362458
})

print("[SS Chatbot] entrypoint v8 ready")
