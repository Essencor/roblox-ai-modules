-- SS Chatbot public loader
-- Loads the restored original hub, applies Luau compile fixes, then runs it.

print("[SS Chatbot] loader v17 started")

local SOURCE_URL = "https://raw.githubusercontent.com/Essencor/roblox-ai-modules/98bdb57616fe9e5278046129d034638813e5fc6b/ss-chatbot"
local DEFAULT_OPENROUTER_KEY = table.concat({
   "sk-or-v1-fb43347952a4ca51",
   "e587a591bd1a8bb6e8af00aa",
   "123037573a602e4b9a61790c"
})

local MODEL_REPLACEMENTS = {
   ["tngtech/deepseek-r1t2-chimera:free"] = "google/gemma-4-31b-it:free",
   ["mistralai/devstral-2512:free"] = "nousresearch/hermes-3-llama-3.1-405b:free",
   ["xiaomi/mimo-v2-flash:free"] = "cognitivecomputations/dolphin-mistral-24b-venice-edition:free"
}

local BUILT_IN_KEY_REPLACEMENTS = {
   "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",
   "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",
   "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"
}

local okFetch, source = pcall(function()
   return game:HttpGet(SOURCE_URL, true)
end)

if not okFetch then
   error("[SS Chatbot] HttpGet failed: " .. tostring(source))
end

if type(source) ~= "string" or source == "" then
   error("[SS Chatbot] Empty source from GitHub")
end

-- Seed the script's default custom OpenRouter key.
source = source:gsub(
   'ApiKey = "",',
   'ApiKey = "' .. DEFAULT_OPENROUTER_KEY .. '",',
   1
)

-- Swap the public free model IDs everywhere they appear, including defaults and dropdown options.
for oldModel, newModel in pairs(MODEL_REPLACEMENTS) do
   source = source:gsub(oldModel:gsub("%-", "%%-"), newModel)
end

-- Replace all bundled OpenRouter keys with the current key.
for _, oldKey in ipairs(BUILT_IN_KEY_REPLACEMENTS) do
   source = source:gsub(oldKey:gsub("%-", "%%-"), DEFAULT_OPENROUTER_KEY)
end

-- Make API calls prefer Config.ApiKey when it has a default/custom value.
source = source:gsub(
   'local apiKeyToUse = ModelApiKeys%[Config%.Model%] or Config%.ApiKey',
   'local apiKeyToUse = (Config.ApiKey ~= "" and Config.ApiKey ~= nil) and Config.ApiKey or ModelApiKeys[Config.Model]',
   1
)

-- The original script creates an empty set of tabs first, then creates the real
-- tabs again where the UI content is added. Remove the empty first set.
local duplicateTabBlock = [==[
-- Create Tabs
local ChatTab = Window:CreateTab("Chatbot", 4483362458)
local APITab = Window:CreateTab("API Setup", 4483362458)
local PromptsTab = Window:CreateTab("Prompts", 4483362458)
local DebugTab = Window:CreateTab("Debug", 4483362458)
local ModulesTab = Window:CreateTab("Modules", 4483362458)
local MemoryTab = Window:CreateTab("Memory", 4483362458)
local SettingsTab = Window:CreateTab("Settings", 4483362458)
]==]

local removedExact
source, removedExact = source:gsub(duplicateTabBlock, "-- Tabs are created below, next to their actual UI content.", 1)

if removedExact == 0 then
   source = source:gsub(
      "%-%- Create Tabs%s*\nlocal ChatTab = Window:CreateTab%(\"Chatbot\", 4483362458%)%s*\nlocal APITab = Window:CreateTab%(\"API Setup\", 4483362458%)%s*\nlocal PromptsTab = Window:CreateTab%(\"Prompts\", 4483362458%)%s*\nlocal DebugTab = Window:CreateTab%(\"Debug\", 4483362458%)%s*\nlocal ModulesTab = Window:CreateTab%(\"Modules\", 4483362458%)%s*\nlocal MemoryTab = Window:CreateTab%(\"Memory\", 4483362458%)%s*\nlocal SettingsTab = Window:CreateTab%(\"Settings\", 4483362458%)",
      "-- Tabs are created below, next to their actual UI content.",
      1
   )
end

-- The original script has hundreds of top-level UI locals. Roblox/Luau can hit
-- the 200 local-register compile limit near the final Settings labels, so scope
-- the late UI sections before compiling. This preserves the original behavior.
source = source:gsub(
   "MemoryTab = Window:CreateTab%(\"Memory\", 4483362458%)%s*\n%s*local MemorySection = MemoryTab:CreateSection%(\"Memory Statistics\"%)",
   "MemoryTab = Window:CreateTab(\"Memory\", 4483362458)\n\ndo\nlocal MemorySection = MemoryTab:CreateSection(\"Memory Statistics\")",
   1
)

source = source:gsub(
   "local GlobalMemorySlider = MemoryTab:CreateSlider%(%{(.-)\n%}%)%s*\n%s*%-%- ========================================%s*\n%s*%-%- TAB 7: SETTINGS & INFO",
   function(sliderBody)
      return "local GlobalMemorySlider = MemoryTab:CreateSlider({" .. sliderBody .. "\n})\n\n-- Initialize memory stats display while the memory UI locals are still in scope.\nUpdateMemoryStats()\nend\n\n-- ========================================\n-- TAB 7: SETTINGS & INFO"
   end,
   1
)

source = source:gsub(
   "SettingsTab = Window:CreateTab%(\"Settings\", 4483362458%)%s*\n%s*local InfoSection = SettingsTab:CreateSection%(\"Information\"%)",
   "SettingsTab = Window:CreateTab(\"Settings\", 4483362458)\n\ndo\nlocal InfoSection = SettingsTab:CreateSection(\"Information\")",
   1
)

source = source:gsub(
   "%-%- Initialize memory stats display%s*\nUpdateMemoryStats%(%)%s*\n%s*Rayfield:Notify%(%{",
   "end\n\nRayfield:Notify({",
   1
)

local chunk, compileErr = loadstring(source)
if not chunk then
   error("[SS Chatbot] compile failed: " .. tostring(compileErr))
end

print("[SS Chatbot] source compiled. Starting original hub...")

local okRun, runtimeErr = pcall(chunk)
if not okRun then
   error("[SS Chatbot] runtime failed: " .. tostring(runtimeErr))
end

print("[SS Chatbot] original hub started")
