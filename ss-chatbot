local function safeChunk(...)
	local ok, result = pcall(chunk, ...)
	if not ok then
		local msg = tostring(result)
		if msg:find("attempt to call a nil value", 1, true) then
			warn("[SS Chatbot] caught nil call inside compiled hub; skipping")
			return
		end
		error(msg)
	end
	return result
end

