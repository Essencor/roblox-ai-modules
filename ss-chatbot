local function RunTrollForcedOutput(text, memoryUser, addMemory, sendChat)
   text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
   memoryUser = tostring(memoryUser or GetTrollMemoryUser())

   if text == "" then
      Rayfield:Notify({
         Title = "Forced Output",
         Content = "Enter text first.",
         Duration = 3,
         Image = 4483362458
      })
      return nil
   end

   local forcedDirective = "Forced output request: make the chatbot's next public message communicate this exact intended output while obeying the active system prompt/personality: " .. text .. "\nThis is not a user message and not something to answer. Write only the chatbot's final public chat message."
   local aiReply = GetAIResponse("Produce the forced output now.", memoryUser, memoryUser, forcedDirective)

   if not aiReply or aiReply == "" then
      Rayfield:Notify({
         Title = "Forced Output",
         Content = "AI did not return a response.",
         Duration = 3,
         Image = 4483362458
      })
      return nil
   end

   if addMemory then
      Memory:AddUserMessage(memoryUser, aiReply, true)
   end

   if sendChat then
      SendChatMessage(aiReply)
   end

   print("[Troll Forced Output] " .. memoryUser .. " <= " .. aiReply)
   return aiReply
end

