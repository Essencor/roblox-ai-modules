-- SS Chatbot Starter for Roblox
-- Safe self-running client script with optional Rayfield UI.
-- If external UI or HTTP helpers fail, the script falls back to console-only mode
-- instead of throwing a nil-call on startup.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	warn("[SS Chatbot] LocalPlayer is not available.")
	return
end

local Config = {
	Enabled = true,
	BotName = "SS Assistant",
	ApiKey = "",
	Model = "mistralai/devstral-2512:free",
	Prefix = "!",
	MinDelay = 2,
	SystemPrompt = "You are a helpful Roblox chatbot for developers. Keep replies short, clear, and friendly.",
}

local lastReplyAt = 0
local pendingRequest = false
local recentUserReply = {}

local function safeHttpGet(url)
	local ok, result = pcall(function()
		return game:HttpGet(url, true)
	end)

	if ok and type(result) == "string" and #result > 0 then
		return result
	end

	return nil, result
end

local function loadRemoteChunk(url, label)
	local source, sourceErr = safeHttpGet(url)
	if not source then
		return nil, string.format("%s fetch failed: %s", label, tostring(sourceErr))
	end

	local chunk, compileErr = loadstring(source)
	if not chunk then
		return nil, string.format("%s loadstring failed: %s", label, tostring(compileErr))
	end

	local ok, result = pcall(chunk)
	if not ok then
		return nil, string.format("%s runtime failed: %s", label, tostring(result))
	end

	return result
end

local function tryLoadRayfield()
	local ok, result = pcall(function()
		return loadRemoteChunk("https://sirius.menu/rayfield", "Rayfield")
	end)

	if ok and result then
		return result
	end

	warn("[SS Chatbot] Rayfield unavailable: " .. tostring(result))
	return nil
end

local Rayfield = tryLoadRayfield()

local function httpRequest(url, method, headers, body)
	local requestFn = (syn and syn.request)
		or (http and http.request)
		or http_request
		or request

	if requestFn then
		local response = requestFn({
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})

		if type(response) == "table" then
			return response.Success ~= false, response.Body or "", response.StatusCode or 0
		end

		return false, tostring(response), 0
	end

	local requestOptions = {
		Url = url,
		Method = method or "GET",
		Headers = headers or {},
	}

	if body then
		requestOptions.Body = body
	end

	local ok, response = pcall(function()
		return HttpService:RequestAsync(requestOptions)
	end)

	if ok and type(response) == "table" then
		return response.Success ~= false, response.Body or "", response.StatusCode or 0
	end

	return false, tostring(response), 0
end

local function setStatus(text)
	print("[SS Chatbot] " .. text)
	if Rayfield and Rayfield.Notify then
		pcall(function()
			Rayfield:Notify({
				Title = "SS Chatbot",
				Content = text,
				Duration = 3,
			})
		end)
	end
end

local function sendSystemMessage(text)
	local channels = TextChatService:FindFirstChild("TextChannels")
	if channels then
		local general = channels:FindFirstChild("RBXGeneral")
		if general and general.DisplaySystemMessage then
			pcall(function()
				general:DisplaySystemMessage(text)
			end)
			return
		end
	end

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = text,
			Color = Color3.fromRGB(180, 220, 255),
			Font = Enum.Font.SourceSansBold,
			TextSize = 18,
		})
	end)
end

local function buildMessages(userMessage)
	return {
		{ role = "system", content = Config.SystemPrompt },
		{ role = "user", content = userMessage },
	}
end

local function getAIResponse(userMessage)
	local apiKey = Config.ApiKey
	if apiKey == nil or apiKey == "" then
		return "Set ApiKey in ss-chatbot before using AI replies."
	end

	local requestBody = HttpService:JSONEncode({
		model = Config.Model,
		messages = buildMessages(userMessage),
		temperature = 0.7,
		max_tokens = 120,
	})

	local ok, body, statusCode = httpRequest(
		"https://openrouter.ai/api/v1/chat/completions",
		"POST",
		{
			["Authorization"] = "Bearer " .. apiKey,
			["Content-Type"] = "application/json",
		},
		requestBody
	)

	if not ok then
		return nil, "HTTP request failed: " .. tostring(body) .. " (" .. tostring(statusCode) .. ")"
	end

	local decodedOk, decoded = pcall(function()
		return HttpService:JSONDecode(body)
	end)

	if not decodedOk then
		return nil, "Could not decode API response."
	end

	local choice = decoded and decoded.choices and decoded.choices[1]
	local message = choice and choice.message and choice.message.content
	if type(message) ~= "string" or message == "" then
		return nil, "API returned an empty response."
	end

	return message
end

local function shouldRespond(message)
	local lower = string.lower(message or "")
	if string.sub(lower, 1, #Config.Prefix) == Config.Prefix then
		return true
	end
	return string.find(lower, string.lower(Config.BotName), 1, true) ~= nil
end

local function normalizePrompt(message)
	if string.sub(message, 1, #Config.Prefix) == Config.Prefix then
		return string.sub(message, #Config.Prefix + 1)
	end
	return message
end

local function replyToMessage(player, message)
	if not Config.Enabled then
		return
	end

	if pendingRequest then
		return
	end

	local now = os.clock()
	if now - lastReplyAt < Config.MinDelay then
		return
	end

	if recentUserReply[player.Name] and now - recentUserReply[player.Name] < Config.MinDelay then
		return
	end

	if not shouldRespond(message) then
		return
	end

	pendingRequest = true
	recentUserReply[player.Name] = now
	lastReplyAt = now

	local prompt = normalizePrompt(message)
	local response, err = getAIResponse(prompt)

	if response then
		sendSystemMessage(string.format("[%s] %s", Config.BotName, response))
	else
		sendSystemMessage(string.format("[%s] %s", Config.BotName, err or "No response available."))
	end

	pendingRequest = false
end

local function connectPlayer(player)
	if player == LocalPlayer then
		return
	end

	player.Chatted:Connect(function(message)
		replyToMessage(player, message)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	connectPlayer(player)
end

Players.PlayerAdded:Connect(connectPlayer)

if Rayfield then
	pcall(function()
		Rayfield:Notify({
			Title = "SS Chatbot Loaded",
			Content = "Rayfield is available, but the chatbot will still run safely without it.",
			Duration = 4,
		})
	end)
end

setStatus("Loaded successfully. Configure ApiKey and Model before enabling AI replies.")
