-- SS Chatbot v44 bootstrap
-- Runtime OpenRouter key + requested model list, with safer patch injection.

local env = (getgenv and getgenv()) or _G
local runtimeKey = env.SS_CHATBOT_OPENROUTER_KEY

if type(runtimeKey) ~= "string" or runtimeKey == "" then
	error("[SS Chatbot] Set getgenv().SS_CHATBOT_OPENROUTER_KEY before loading ss-chatbot-v44")
end

local LOADER_URL = "https://raw.githubusercontent.com/Essencor/roblox-ai-modules/main/ss-chatbot?fresh=v44-models-20260601"

local okFetch, loaderSource = pcall(function()
	return game:HttpGet(LOADER_URL, true)
end)

if not okFetch then
	error("[SS Chatbot] bootstrap HttpGet failed: " .. tostring(loaderSource))
end

if type(loaderSource) ~= "string" or loaderSource == "" then
	error("[SS Chatbot] bootstrap got empty loader source")
end

loaderSource = loaderSource:gsub(
	'local DEFAULT_OPENROUTER_KEY = "[^"]*"',
	'local DEFAULT_OPENROUTER_KEY = runtimeKey',
	1
)

local modelPatch = [==[
source = source:gsub('Model = "[^\"]+",', 'Model = "google/gemma-4-31b-it:free",', 1)

source = source:gsub(
	'%-%- Model%-Specific API Keys%s*local ModelApiKeys = {%s*.-%s*}',
	function()
		return [[-- Model-Specific API Keys
local ModelApiKeys = {
   ["google/gemma-4-31b-it:free"] = DEFAULT_OPENROUTER_KEY,
   ["nousresearch/hermes-3-llama-3.1-405b:free"] = DEFAULT_OPENROUTER_KEY,
   ["cognitivecomputations/dolphin-mistral-24b-venice-edition:free"] = DEFAULT_OPENROUTER_KEY
}]]
	end,
	1
)

source = source:gsub(
	'%-%- Available Free Models%s*local AvailableModels = {%s*.-%s*}',
	function()
		return [[-- Available Free Models
local AvailableModels = {
   "google/gemma-4-31b-it:free",
   "nousresearch/hermes-3-llama-3.1-405b:free",
   "cognitivecomputations/dolphin-mistral-24b-venice-edition:free"
}]]
	end,
	1
)

source = source:gsub(
	'local apiKeyToUse = %(Config%.ApiKey ~= "" and Config%.ApiKey ~= nil%) and Config%.ApiKey or ModelApiKeys%[Config%.Model%]',
	'local apiKeyToUse = (Config.ApiKey ~= "" and Config.ApiKey ~= nil) and Config.ApiKey or (ModelApiKeys[Config.Model] or DEFAULT_OPENROUTER_KEY)',
	1
)

source = source:gsub(
	'local apiKeyToUse = ModelApiKeys%[Config%.Model%] or Config%.ApiKey',
	'local apiKeyToUse = (Config.ApiKey ~= "" and Config.ApiKey ~= nil) and Config.ApiKey or (ModelApiKeys[Config.Model] or DEFAULT_OPENROUTER_KEY)',
	1
)

]==]

local inserted
loaderSource, inserted = loaderSource:gsub(
	'local chunk, compileErr = loadstring%(source%)',
	modelPatch .. 'local chunk, compileErr = loadstring(source)',
	1
)

if inserted == 0 then
	error("[SS Chatbot] bootstrap could not find loader compile point")
end

loaderSource = loaderSource:gsub("loader v40 started", "loader v44 started", 1)
loaderSource = loaderSource:gsub("public loader v40", "public loader v44", 1)

local loaderChunk, loaderCompileErr = loadstring(loaderSource)
if not loaderChunk then
	error("[SS Chatbot] bootstrap compile failed: " .. tostring(loaderCompileErr))
end

local loaderEnv = setmetatable({ runtimeKey = runtimeKey }, { __index = getfenv and getfenv(0) or _G })
if setfenv then
	setfenv(loaderChunk, loaderEnv)
end

return loaderChunk()
