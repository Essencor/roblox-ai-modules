-- SS Chatbot v43 bootstrap
-- Runtime OpenRouter key + updated free model list.

local env = (getgenv and getgenv()) or _G
local runtimeKey = env.SS_CHATBOT_OPENROUTER_KEY

if type(runtimeKey) ~= "string" or runtimeKey == "" then
	error("[SS Chatbot] Set getgenv().SS_CHATBOT_OPENROUTER_KEY before loading ss-chatbot-v43")
end

local LOADER_URL = "https://raw.githubusercontent.com/Essencor/roblox-ai-modules/main/ss-chatbot?fresh=v43-models-20260601"

local okFetch, loaderSource = pcall(function()
	return game:HttpGet(LOADER_URL, true)
end)

if not okFetch then
	error("[SS Chatbot] bootstrap HttpGet failed: " .. tostring(loaderSource))
end

if type(loaderSource) ~= "string" or loaderSource == "" then
	error("[SS Chatbot] bootstrap got empty loader source")
end

loaderSource = loaderSource:gsub(
	'local DEFAULT_OPENROUTER_KEY = "[^"]*"',
	'local DEFAULT_OPENROUTER_KEY = runtimeKey',
	1
)

loaderSource = loaderSource:gsub(
	'source = source:gsub%(\'Model = "mistralai/devstral%%%-2512:free",\', \'Model = "\' %.%. freeModels%[1%] %.%. \'",\', 1%)',
	function()
		return [[source = source:gsub('Model = "mistralai/devstral%-2512:free",', 'Model = "google/gemma-4-31b-it:free",', 1)]]
	end,
	1
)

loaderSource = loaderSource:gsub(
	'local freeModels = {%s*"google/gemma%-4%-31b%-it:free",%s*"meta%-llama/llama%-3%.2%-3b%-instruct:free",%s*"cognitivecomputations/dolphin%-mistral%-24b%-venice%-edition:free"%s*}',
	function()
		return [[local freeModels = {
	"google/gemma-4-31b-it:free",
	"nousresearch/hermes-3-llama-3.1-405b:free",
	"cognitivecomputations/dolphin-mistral-24b-venice-edition:free"
}]]
	end,
	1
)

loaderSource = loaderSource:gsub(
	'local modelKeyBlock = %[==%[%s*%-%- Model%-Specific API Keys%s*local ModelApiKeys = {%s*.-%s*}%s*%]==%]:gsub%("DEFAULT_OPENROUTER_KEY", DEFAULT_OPENROUTER_KEY%)',
	function()
		return [[local modelKeyBlock = [==[
-- Model-Specific API Keys
local ModelApiKeys = {
   ["google/gemma-4-31b-it:free"] = DEFAULT_OPENROUTER_KEY,
   ["nousresearch/hermes-3-llama-3.1-405b:free"] = DEFAULT_OPENROUTER_KEY,
   ["cognitivecomputations/dolphin-mistral-24b-venice-edition:free"] = DEFAULT_OPENROUTER_KEY
}
]==]:gsub("DEFAULT_OPENROUTER_KEY", DEFAULT_OPENROUTER_KEY)]]
	end,
	1
)

loaderSource = loaderSource:gsub(
	'local availableModelsBlock = %[==%[%s*%-%- Available Free Models%s*local AvailableModels = {%s*.-%s*}%s*%]==%]',
	function()
		return [[local availableModelsBlock = [==[
-- Available Free Models
local AvailableModels = {
   "google/gemma-4-31b-it:free",
   "nousresearch/hermes-3-llama-3.1-405b:free",
   "cognitivecomputations/dolphin-mistral-24b-venice-edition:free"
}
]==]]]
	end,
	1
)

loaderSource = loaderSource:gsub(
	'local apiKeyToUse = %(Config%.ApiKey ~= "" and Config%.ApiKey ~= nil%) and Config%.ApiKey or ModelApiKeys%[Config%.Model%]',
	'local apiKeyToUse = (Config.ApiKey ~= "" and Config.ApiKey ~= nil) and Config.ApiKey or (ModelApiKeys[Config.Model] or runtimeKey)',
	1
)

loaderSource = loaderSource:gsub(
	'local apiKeyToUse = ModelApiKeys%[Config%.Model%] or Config%.ApiKey',
	'local apiKeyToUse = (Config.ApiKey ~= "" and Config.ApiKey ~= nil) and Config.ApiKey or (ModelApiKeys[Config.Model] or runtimeKey)',
	1
)

loaderSource = loaderSource:gsub("loader v40 started", "loader v43 started", 1)
loaderSource = loaderSource:gsub("public loader v40", "public loader v43", 1)

local loaderChunk, loaderCompileErr = loadstring(loaderSource)
if not loaderChunk then
	error("[SS Chatbot] bootstrap compile failed: " .. tostring(loaderCompileErr))
end

local loaderEnv = setmetatable({ runtimeKey = runtimeKey }, { __index = getfenv and getfenv(0) or _G })
if setfenv then
	setfenv(loaderChunk, loaderEnv)
end

return loaderChunk()
